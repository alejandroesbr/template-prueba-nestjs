# ==============================================================================
# APPLICATION CONFIGURATION
# ==============================================================================
NODE_ENV=development
PORT=3000
API_PREFIX=api/v1
CORS_ORIGIN=*

# ==============================================================================
# SWAGGER DOCUMENTATION
# ==============================================================================
SWAGGER_ENABLED=true
SWAGGER_TITLE=Technical Assessment API
SWAGGER_DESCRIPTION=RESTful API built with NestJS using Package by Feature Architecture
SWAGGER_VERSION=1.0.0
SWAGGER_PATH=docs

# ==============================================================================
# DATABASE CONFIGURATION (Adapt according to technical test requirements)
# ==============================================================================
# Example for PostgreSQL / MySQL / MongoDB / Prisma / TypeORM:
DB_TYPE=postgres
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=app_db
DB_SYNCHRONIZE=true
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/app_db?schema=public

# ==============================================================================
# AUTHENTICATION CONFIGURATION (JWT / Better Auth / OAuth2 / API Gateway)
# ==============================================================================
JWT_SECRET=super-secret-change-in-production
JWT_EXPIRES_IN=1d
BETTER_AUTH_SECRET=super-secret-better-auth-key
BETTER_AUTH_URL=http://localhost:3000

